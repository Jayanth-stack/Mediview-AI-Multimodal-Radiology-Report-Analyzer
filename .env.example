# MediViewAI environment configuration
# Copy to .env and fill in values: `cp .env.example .env`
# Do not put real credentials in this file.

# --- Environment ---
ENV=dev
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000
SECRET_KEY=

# --- Postgres (pgvector) ---
POSTGRES_USER=mediview
POSTGRES_PASSWORD=
POSTGRES_DB=mediview
# Backend/celery connect via the compose service hostname `postgres`.
# Format: postgresql+psycopg://USER:PASSWORD@postgres:5432/DBNAME
DATABASE_URL=

# --- Object storage (MinIO / S3) ---
# In-cluster endpoint used by backend + createbuckets (compose service hostname `minio`).
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=mediview
S3_SECURE=false

# --- AI / Gemini ---
# Leave GEMINI_API_KEY empty to use deterministic stub findings (no external calls).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_VISION_MODEL=gemini-1.5-flash
